  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['fullName','publicName','status','createdAt','updatedAt'])",
        "fullName": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80"
        },
        "publicName": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
        },
        "status": {
          ".validate": "newData.isString() && newData.val() === 'active'"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "players": {
      ".read": true,
      ".indexOn": [
        "score"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || root.child('users').child(auth.uid).child('status').val() === 'active')",
        ".validate": "newData.hasChildren(['name','rankId','level','xp','score','percentile','updatedAt','bests'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40 && newData.val() === root.child('users').child($uid).child('publicName').val()"
        },
        "rankId": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z]{3,12}$/)"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 500"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "percentile": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
